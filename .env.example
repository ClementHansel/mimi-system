# =============================================================================
# Mimi Chicken Operational System - Environment Configuration (LOCAL / DEV template)
# =============================================================================
# Copy this file to .env for local development:
#     cp .env.example .env
# For a production VPS use .env.prod.example instead.
# No real secrets below — placeholders only.

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Local domain, only meaningful for the prod overlay's Traefik routing rules.
DOMAIN=localhost
# WITA fixed app-wide (D-11). Do NOT change to Asia/Jakarta.
TZ=Asia/Makassar
PGTZ=Asia/Makassar
# Rendered locale (id-ID) and currency (IDR) — single-tenant, no per-tenant override.
LOCALE=id-ID
CURRENCY=IDR

# =============================================================================
# Host ports (what the containers publish on YOUR machine, 127.0.0.1 only)
# =============================================================================
BACKEND_PORT=4000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
N8N_PORT=5678
# Only used when the optional branch-node profile is started (docker-compose.dev.yml).
BRANCH_NODE_PORT=4010

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=mimi
POSTGRES_USER=mimi
POSTGRES_PASSWORD=mimi_secret

# =============================================================================
# Database connections — TWO DELIBERATELY SEPARATE IDENTITIES (D-21 / D-22)
# =============================================================================
# The app must never connect to Postgres as a table owner or superuser —
# Postgres skips Row-Level Security for both, regardless of FORCE ROW LEVEL
# SECURITY. This is not theoretical: a single shared connection string is
# exactly how this broke once already (a Kasir context saw all 418 sales
# instead of 64, and all 324 supplier price-history rows instead of 0 — see
# BUILD-PLAN D-22). Do NOT "simplify" these two vars back into one.
#
#   DATABASE_URL           the RUNTIME connection. Used by the backend only.
#                          Authenticates as `mimi_app`: a dedicated
#                          non-superuser LOGIN role, NOBYPASSRLS, owns
#                          nothing, granted membership in `app_user` (the
#                          role RlsContextGuard `SET ROLE`s into per
#                          request). Created by a database migration (D-21).
#
#   DATABASE_MIGRATION_URL the OWNER connection. Used ONLY by
#                          @mimi/database's migrate/seed/reset scripts,
#                          which must own and create schema objects.
#                          Authenticates as the Postgres superuser
#                          (POSTGRES_USER above).
#
# The direction is deliberate, not arbitrary: if DATABASE_MIGRATION_URL is
# ever missing, migrations fail loudly and get fixed in a minute. Had the
# superuser connection been the default instead — with runtime needing the
# extra var — forgetting that var would have the app silently running as
# superuser with RLS disabled: the exact incident this fixes, reintroduced
# by omission. Always arrange it so the lazy failure is the loud one.
DATABASE_URL=postgresql://mimi_app:mimi_app_secret@localhost:5432/mimi
DATABASE_MIGRATION_URL=postgresql://mimi:mimi_secret@localhost:5432/mimi
# Password for the mimi_app LOGIN role (the role itself is created by a
# database migration owned by senior-db, D-21). This is what
# docker-compose.yml uses to build the backend container's DATABASE_URL —
# keep it in sync with the value above.
DB_APP_PASSWORD=mimi_app_secret

# =============================================================================
# Redis (cache + distributed locks)
# =============================================================================
REDIS_PASSWORD=mimi_redis_secret

# =============================================================================
# MinIO (Object Storage — bukti foto: receiving, waste, petty cash, payment,
# selfie absensi, servis, surat jalan)
# =============================================================================
MINIO_ROOT_USER=mimi_minio
MINIO_ROOT_PASSWORD=mimi_minio_secret
MINIO_BUCKET=mimi-storage

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change_me_in_production_use_a_strong_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_use_a_different_strong_string
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# SMTP (in-app + email notifications, D-03)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mimichicken.local

# =============================================================================
# WhatsApp channel (D-03) — delivered via an n8n webhook, not a direct WA SDK.
# WA_ENABLED=false (the default) writes to a wa_outbox table instead of
# sending — the whole pipeline is exercised without a real WA gateway
# (RISK-P4: client must supply real gateway credentials by end of Week 1).
# Flip WA_ENABLED=true once credentials are wired into the n8n workflow.
# =============================================================================
WA_ENABLED=false
N8N_WEBHOOK_URL_WA=http://n8n:5678/webhook/wa-notify

# =============================================================================
# HR — geofenced attendance (FR-HR-01)
# =============================================================================
# Default allowed radius, in meters, between an employee's GPS check-in and
# their assigned outlet's registered coordinates.
GEOFENCE_RADIUS_METERS=100

# =============================================================================
# Branch node (Tier 2, optional, D-12/D-13) — pairing
# =============================================================================
# Shared secret the cloud (M22 node-gateway) uses to mint/validate pairing
# tokens for a branch-node. Rotate per deployment.
BRANCH_NODE_PAIRING_SECRET=change_me_pairing_secret
# Used only by the branch-node container itself (docker-compose.dev.yml):
BRANCH_NODE_CLOUD_URL=http://backend:4000
BRANCH_NODE_PAIRING_TOKEN=simulate-token

# =============================================================================
# n8n (WhatsApp + payroll-slip automation)
# =============================================================================
# Persisted — credentials/workflows are encrypted with this. MUST be a stable
# random string (regenerating it orphans existing credentials).
N8N_ENCRYPTION_KEY=local_test_n8n_encryption_key_change_me
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678

# =============================================================================
# Internal service wiring (rarely need to change)
# =============================================================================
BACKEND_ORIGIN=http://backend:4000
# CORS allowlist for the backend (main.ts). Comma-separated origins; empty
# means "allow any origin" — fine for local dev, never leave unset in prod
# (see .env.prod.example, which pins it to https://${DOMAIN}).
CORS_ORIGIN=

# =============================================================================
# Frontend (public env vars)
# =============================================================================
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=

# Read by the BACKEND (not the frontend build) to construct the deep link a
# WhatsApp/email approval notification carries into the authenticated app
# (D-24 — the message notifies and links in; it is never itself the decision
# surface). Point this at wherever the frontend is actually served.
APP_WEB_BASE_URL=http://localhost:3000
