# =============================================================================
# Mimi Chicken Operational System - PRODUCTION Environment (VPS template)
# =============================================================================
# On the VPS:  cp .env.prod.example .env   then fill in every "CHANGE_ME".
# Deploy with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Generate strong secrets, e.g.:  openssl rand -hex 32
#
# NOTE: in prod, Traefik is the only public listener (80/443, see
# docker-compose.prod.yml). Every other service stays on 127.0.0.1 at its
# default port from docker-compose.yml — you should not need to touch the
# *_PORT vars here.

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=production
# Public domain. frontend -> https://${DOMAIN}, backend -> https://api.${DOMAIN},
# storage -> https://storage.${DOMAIN}, n8n -> https://n8n.${DOMAIN}.
# Point ALL FOUR DNS records at this server before deploying — Let's Encrypt
# validates each hostname over HTTP, so a missing record means that one service
# comes up without a certificate.
#
# `storage` is not optional. Presigned upload URLs are signed for it, and
# without it the backend hands devices the internal `http://minio:9000`, which
# nothing outside the container network can reach — attendance selfies and waste
# photos are both MANDATORY fields, so they fail while the API still answers 200.
DOMAIN=ops.mimichicken.example
TZ=Asia/Makassar
PGTZ=Asia/Makassar
LOCALE=id-ID
CURRENCY=IDR

# =============================================================================
# Traefik / Let's Encrypt
# =============================================================================
# Email Let's Encrypt uses for expiry/revocation notices. Required.
ACME_EMAIL=CHANGE_ME_ops-alerts@yourcompany.example

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=mimi
POSTGRES_USER=mimi
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# =============================================================================
# Database connections — TWO DELIBERATELY SEPARATE IDENTITIES (D-21 / D-22)
# =============================================================================
# See the matching comment in .env.example for the full rationale. Short
# version: the backend must NEVER connect as a table owner/superuser, or RLS
# is silently bypassed regardless of FORCE ROW LEVEL SECURITY (proven live —
# see BUILD-PLAN D-22). DATABASE_URL (runtime, `mimi_app`) and
# DATABASE_MIGRATION_URL (owner, `POSTGRES_USER`) must stay separate.
#
# CRITICAL: DATABASE_URL / DB_APP_PASSWORD are deliberately left blank below.
# An empty value here must make the backend refuse to start — that is a
# five-second fix once you generate the mimi_app role's real password. A
# working default would silently run the app as the Postgres superuser with
# RLS disabled, which is the exact incident D-22 exists to prevent. Do not
# paste a real secret into this *.example file; set it only in the
# untracked .env on the VPS.
DATABASE_URL=
DB_APP_PASSWORD=CHANGE_ME_mimi_app_login_role_password
# Owner connection for migrate/seed/reset — safe to default-fill here since
# an empty value fails loudly and immediately (see rationale above).
DATABASE_MIGRATION_URL=postgresql://mimi:CHANGE_ME_strong_db_password@localhost:5432/mimi

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# =============================================================================
# MinIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=mimi_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=mimi-storage

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_different_from_jwt_secret
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# SMTP
# =============================================================================
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_EMAIL=noreply@mimichicken.example

# =============================================================================
# WhatsApp channel (D-03) via n8n webhook.
# CRITICAL: set true only once the client's WA gateway credentials (RISK-P4)
# are wired into the n8n workflow — otherwise leave false and let messages
# land in wa_outbox for later review.
# =============================================================================
WA_ENABLED=false

# Shared secret for the INBOUND WhatsApp webhook (n8n -> POST /api/chat/inbound).
# Unset means the endpoint refuses every request, which is the safe direction to
# fail in: chat simply does not receive until this is configured.
N8N_WEBHOOK_SECRET=CHANGE_ME_long_random_webhook_secret

# Object-storage credentials are read as MINIO_ACCESS_KEY/MINIO_SECRET_KEY by the
# backend; docker-compose maps MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above onto
# them, so there is nothing extra to set here. S3_PUBLIC_ENDPOINT is set by
# docker-compose.prod.yml from DOMAIN — no action needed.
N8N_WEBHOOK_URL_WA=http://n8n:5678/webhook/wa-notify

# =============================================================================
# HR — geofenced attendance (FR-HR-01)
# =============================================================================
GEOFENCE_RADIUS_METERS=100

# =============================================================================
# Branch node (Tier 2, optional, D-12/D-13) — pairing
# =============================================================================
BRANCH_NODE_PAIRING_SECRET=CHANGE_ME_long_random_pairing_secret

# =============================================================================
# n8n
# =============================================================================
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# =============================================================================
# Internal service wiring
# =============================================================================
BACKEND_ORIGIN=http://backend:4000
# Set by docker-compose.prod.yml itself (https://${DOMAIN}) — no action
# needed here; documented so it isn't "discovered at deploy time".
CORS_ORIGIN=

# =============================================================================
# Frontend (public env vars). API/WS go through Traefik on the same origin.
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.ops.mimichicken.example
NEXT_PUBLIC_WS_URL=
