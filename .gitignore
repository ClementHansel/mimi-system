# ─── Dependencies ──────────────────────────────────────────────────
node_modules/
# pnpm's content-addressable store. Never let this land in a commit — it turns a
# routine divergence into a repo-wide false-positive conflict (see AIRE history).
.pnpm-store/

# ─── Build Outputs ────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── Environment & Secrets ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── IDE & Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS Generated ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Test & Coverage ──────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ─── Docker ───────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Traefik / Let's Encrypt secrets ──────────────────────────────
infrastructure/traefik/letsencrypt/
infrastructure/traefik/**/acme.json

# ─── n8n runtime data (workflows/credentials are provisioned, not committed) ──
infrastructure/n8n/data/

# ─── Logs ─────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Backups (never commit a real dump) ───────────────────────────
infrastructure/backup/*.sql
infrastructure/backup/*.sql.gz
infrastructure/backup/dumps/

# ─── Misc ─────────────────────────────────────────────────────────
*.tgz
*.gz
.turbo/
.vercel/
.cache/

# ─── Agent tooling & local machine config ─────────────────────────
# Worktrees created per background agent — a working directory, not source.
.claude/worktrees/
# MCP server wiring is per-machine (which servers this laptop can reach), so it
# is local config rather than something every clone should inherit.
.mcp.json

# ─── e2e debug artifacts ──────────────────────────────────────────
# Screenshots dropped at the e2e root while investigating a screen by hand.
# Committed Playwright output already lives under `playwright-report/` and
# `test-results/` (ignored above); these are the ad-hoc ones.
e2e/*.png
# A scratch probe, not a test: no assertions, just `console.log` of button
# labels behind a hardcoded wait. Kept out so it cannot be mistaken for
# coverage — a real spec belongs in `e2e/tests/` and asserts something.
e2e/tests/map-check.spec.ts

# ─── Local scratch / scripts (never commit) ───────────────────────
tmp_*
*.tmp
scratch/

# Server-only production secrets (generated on the VPS, never committed)
.env.vps
