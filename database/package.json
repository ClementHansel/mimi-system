{
  "name": "@mimi/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom SQL migration runner (ported from AIRE), numbered migrations, and a realistic seed: 1 gudang pusat + 20 outlets across 4 Kalimantan cities, storage areas, items, menu products with recipes, employees, suppliers, seeded COA, and devices.",
  "scripts": {
    "migrate": "tsx migrate.ts",
    "migrate:status": "tsx migrate.ts --status",
    "seed": "tsx seed.ts",
    "reset": "tsx reset.ts",
    "test:template": "tsx test-db.ts template",
    "test:clone": "tsx test-db.ts clone",
    "test:drop": "tsx test-db.ts drop",
    "test:list": "tsx test-db.ts list",
    "import": "tsx import.ts",
    "seed:history": "tsx seed-history.ts",
    "simulate:org": "tsx simulate-org.ts",
    "simulate:day": "tsx simulate-day.ts",
    "drill:restore": "tsx backup-restore-drill.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@mimi/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.20.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
