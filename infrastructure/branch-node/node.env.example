# =============================================================================
# Mimi Chicken OS — branch node configuration (W5-07).
#
# Copy to `node.env` ON THE BOX and fill in. Never commit the filled version:
# it carries the local database password and a pairing token.
#
#   cp node.env.example node.env && nano node.env
#
# Every variable below is read by `apps/branch-node/src/config.ts` or by
# docker-compose.node.yml. Nothing else is required — if the node will not
# start, the answer is in here or in the README's troubleshooting table.
# =============================================================================

# --- Which image this box runs -----------------------------------------------
# Pin an explicit version, never `latest`: a box that silently changes version
# on restart makes "it broke last night" unanswerable.
NODE_IMAGE=ghcr.io/REPLACE-ME/mimi-branch-node:0.1.0

# --- Cloud link ---------------------------------------------------------------
# The base URL of the cloud API, including scheme. The node opens ONE outbound
# connection to it; the outlet router needs no inbound rule.
#
# NOTE: use https:// once the cloud has TLS (blocker B-14). Over plain http the
# link still works, but the pairing token and all outlet traffic cross the
# internet unencrypted — acceptable for a lab box, not for a real outlet.
BRANCH_NODE_CLOUD_URL=https://REPLACE-ME

# One-time pairing token, minted in the owner UI (see README step 3).
# It is consumed at first successful registration.
BRANCH_NODE_PAIRING_TOKEN=

# --- Local database -----------------------------------------------------------
# The node's OWN Postgres, which is what lets the outlet keep working when the
# internet is down. Generate a long random value; it never leaves the box.
NODE_POSTGRES_PASSWORD=REPLACE-ME
NODE_POSTGRES_DB=mimi_node
NODE_POSTGRES_USER=mimi_node

# --- LAN ----------------------------------------------------------------------
# The box's own LAN address. Tablets in the outlet reach the node here.
# Deliberately NOT 0.0.0.0 — see the compose file's comment.
NODE_LAN_BIND=127.0.0.1

# Optional. Leave blank to auto-derive from the box's interfaces. Set only when
# an outlet has several subnets and discovery latches onto the wrong one.
BRANCH_NODE_SCAN_SUBNET=

# Optional. Defaults to the machine hostname; set it to something a human will
# recognise in the topology screen, e.g. "node-bjm01".
BRANCH_NODE_HOSTNAME=
