{
  "name": "mimi-chicken-operational-system",
  "version": "0.1.0",
  "private": true,
  "description": "Mimi Chicken Operational System - single-tenant POS, logistics, HR/payroll, GL and three-tier offline-first sync for a fried-chicken warehouse-and-outlet network in Kalimantan.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mimi/backend dev & pnpm --filter @mimi/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r --filter=!@mimi/e2e test",
    "test:watch": "pnpm -r test:watch",
    "db:migrate": "pnpm --filter @mimi/database migrate",
    "db:migrate:status": "pnpm --filter @mimi/database migrate:status",
    "db:seed": "pnpm --filter @mimi/shared build && pnpm --filter @mimi/database seed && pnpm --filter @mimi/database seed:journal",
    "db:seed:journal": "pnpm --filter @mimi/database seed:journal",
    "db:reset": "pnpm --filter @mimi/shared build && pnpm --filter @mimi/database reset",
    "db:test:template": "pnpm --filter @mimi/database test:template",
    "db:test:clone": "pnpm --filter @mimi/database test:clone",
    "db:test:drop": "pnpm --filter @mimi/database test:drop",
    "db:test:list": "pnpm --filter @mimi/database test:list",
    "e2e": "pnpm --filter @mimi/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
