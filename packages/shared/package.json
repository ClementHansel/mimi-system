{
  "name": "@mimi/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Enums, types, RBAC matrix, error codes, state machines, money/qty math (NUMERIC-safe), WITA date helpers, payroll calculators, GL balance validator. Pure functions, zero I/O.",
